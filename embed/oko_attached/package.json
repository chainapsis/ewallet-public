    "@keplr-wallet/types": "0.12.297",
    "@keplr-wallet/unit": "0.12.297",
    "@oko-wallet/api-lib": "workspace:*",
    "@oko-wallet/bytes": "^0.1.2-alpha.1",
    "@oko-wallet/cait-sith-keplr-hooks": "workspace:*",
    "@oko-wallet/cait-sith-keplr-wasm": "workspace:*",
    "@oko-wallet/crypto-js": "^0.1.2-alpha.1",
    "@oko-wallet/dotenv": "^0.0.2-alpha.29",
