{
  "name": "@oko-wallet/oko-attached",
  "version": "0.1.1-alpha.9",
  "private": true,
  "type": "module",
  "scripts": {
    "create_env": "tsx src/bin/create_env.ts",
    "clean": "del-cli ./public/pkg",
    "copy_wasm": "yarn run clean && mkdir -p ./public/pkg && cp ../../crypto/tecdsa/cait_sith_keplr_wasm/pkg/cait_sith_keplr_wasm_bg.wasm ./public/pkg/ && cp ../../crypto/teddsa/frost_ed25519_keplr_wasm/pkg/frost_ed25519_keplr_wasm_bg.wasm ./public/pkg/",
    "copy_wasm_cs": "mkdir -p ./public/pkg && cp ../../crypto/tecdsa/cait_sith_keplr_wasm/pkg/cait_sith_keplr_wasm_bg.wasm ./public/pkg/",
    "copy_wasm_frost": "mkdir -p ./public/pkg && cp ../../crypto/teddsa/frost_ed25519_keplr_wasm/pkg/frost_ed25519_keplr_wasm_bg.wasm ./public/pkg/",
    "dev": "tsx ./src/bin/launch.ts",
    "build": "vite build && tsc --noEmit",
    "serve": "vite preview",
    "start": "tsx ./src/bin/launch.ts",
    "typecheck": "tsc",
    "format": "yarn exec biome format --write",
    "lint": "yarn exec biome lint --write",
    "check": "yarn exec biome check --write"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.18.1",
    "@cosmjs/amino": "0.36.1",
    "@cosmjs/proto-signing": "0.36.1",
    "@floating-ui/dom": "^1.7.4",
    "@floating-ui/react": "^0.27.16",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@fontsource-variable/inter": "^5.2.8",
    "@keplr-wallet/cosmos": "^0.12.210",
