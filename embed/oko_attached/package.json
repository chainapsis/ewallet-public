    "bs58": "^6.0.0",
    "chalk": "^5.5.0",
    "cosmjs-types": "^0.9.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-error-boundary": "^6.0.0",
    "starknet": "^7.6.4",
    "uuid": "^13.0.0",
    "viem": "^2.41.2",
    "vite": "^7.1.6",
    "zod": "^4.1.12",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
